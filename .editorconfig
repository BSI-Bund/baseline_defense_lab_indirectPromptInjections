root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{ts,js,scss,css,html,json,yml,yaml}]
indent_size = 2

[*.md]
# Trailing whitespace is significant in Markdown (two spaces = hard line break).
trim_trailing_whitespace = false
# One line per paragraph, no hard wrapping: the rendered output is identical
# either way, but a reflowed paragraph makes a one-word edit look like a
# rewrite in the diff. Editors should not re-wrap these files.
max_line_length = off
