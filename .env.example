#
# Example environment configuration for Baseline-Defense-Lab.
# Copy to .env and adjust as needed. NEVER put real secrets here - this stack
# has no authentication and is meant for local/loopback use only.

# Base URL the backend uses to reach Ollama.
OLLAMA_URL=http://localhost:11434

# Default chat model pulled by ollama-init and offered in the UI.
OLLAMA_MODEL=gemma3:12b

# Optional: space/comma-separated list to pull several models at once.
# OLLAMA_MODELS=gemma3:12b qwen3:30b qwen3:14b

# Comma-separated CORS allowlist. Defaults to the local serving ports.
# Never use a wildcard on this unauthenticated API.
# CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8000,http://127.0.0.1:8000

# Optional: explicit path to the built Angular SPA (set inside Docker).
# BDL_FRONTEND_DIR=/app/frontend_dist

# Optional: comma-separated model allowlist. Empty = any valid Ollama tag.
# BDL_MODEL_ALLOWLIST=gemma3:12b,qwen3:30b,qwen3:14b

# Optional: opt-in verbose backend debug logging (default OFF). Loopback dev only.
# Redacts attacker-controlled document text; never logs canary tokens or answers.
# BDL_DEBUG=1
# LOG_LEVEL=DEBUG
