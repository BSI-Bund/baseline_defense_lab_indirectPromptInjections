# Normalise line endings to LF in the repository so shell heredocs in the
# Dockerfiles / compose file and all source stay POSIX-clean on every host.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.pdf binary
*.png binary
*.ico binary
*.woff binary
*.woff2 binary
